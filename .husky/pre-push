#!/bin/sh

TOTAL=11
STEP=0

gate() {
  STEP=$((STEP + 1))
  LABEL="$1"
  echo "[HUSKY] ${STEP}/${TOTAL} ${LABEL}..."
  shift
  if ! "$@"; then
    echo "[HUSKY ERROR] ${LABEL} failed. Push aborted."
    exit 1
  fi
}

echo "[HUSKY] Running Full Monorepo Build Gate..."

gate "Re-running Strict TypeScript Typecheck" pnpm typecheck
gate "Building Dock App" pnpm dock:build
gate "Building Headquarter App" pnpm headquarter:build
gate "Building ID App" pnpm id:build
gate "Building Jizz App" pnpm jizz:build
gate "Building Gate App" pnpm gate:build
gate "Building Arsy Fastify Hub" pnpm arsy:build
gate "Building Sentinel RADIUS Daemon" pnpm sentinel:build
gate "Building VS Code Extension" pnpm extension:build
gate "Running Design System Tests" pnpm ui:test
gate "Running Skin Contrast Gate" pnpm ui:contrast

echo "[HUSKY] Pre-push gate passed successfully."
