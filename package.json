{
  "name": "moonwitness-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm lint:arch && pnpm typecheck && concurrently --kill-others --success first \"pnpm arsy:dev\" \"pnpm dock:dev\" \"pnpm headquarter:dev\" \"pnpm id:dev\" \"pnpm jizz:dev\"",
    "dock:dev": "pnpm --filter @moonwitness/dock dev",
    "dock:build": "pnpm --filter @moonwitness/types build && pnpm --filter @allah/sdk build && pnpm --filter @moonwitness/dock build",
    "headquarter:dev": "pnpm --filter @moonwitness/headquarter dev",
    "headquarter:build": "pnpm --filter @moonwitness/types build && pnpm --filter @allah/sdk build && pnpm --filter @moonwitness/headquarter build",
    "id:dev": "pnpm --filter @moonwitness/id dev",
    "id:build": "pnpm --filter @moonwitness/types build && pnpm --filter @allah/sdk build && pnpm --filter @moonwitness/id build",
    "jizz:dev": "pnpm --filter @moonwitness/jizz dev",
    "jizz:build": "pnpm --filter @moonwitness/jizz build",

    "extension:build": "pnpm --filter @moonwitness/types build && pnpm --filter @allah/sdk build && pnpm --filter allah-vscode-extension build",
    "extension:check": "node scripts/check-vscode-extension-runtime.mjs",
    "extension:test": "tsx --test packages/vscode-extension/src/planManager.test.ts packages/vscode-extension/src/gatewayContracts.test.ts packages/vscode-extension/src/agentPolicy.test.ts packages/vscode-extension/src/localAgentCore.test.ts packages/sdk/src/index.test.ts packages/arsy-orm/src/query_builder.test.ts packages/arsy-plugin-llm-gateway/test/device_control.test.ts",
    "docs:check": "tsx scripts/check-doc-contracts.ts",
    "lint:arch": "node packages/lint/src/check-architecture.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsx scripts/typecheck.ts",
    "arsy:dev": "pnpm --filter @allah/arsy dev",
    "arsy:build": "pnpm --filter @allah/arsy build",
    "sentinel:dev": "pnpm --filter @allah/sentinel dev",
    "sentinel:build": "pnpm --filter @allah/sentinel build",
    "sentinel:start": "pnpm --filter @allah/sentinel start"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1",
    "wait-on": "^9.5.1"
  }
}
