{
  "name": "moonwitness-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "concurrently --kill-others --success first \"pnpm dock:dev && pnpm headquarter:dev\"",
    "dock:dev": "pnpm --filter @moonwitness/dock dev",
    "dock:build": "pnpm --filter @moonwitness/dock build",
    "headquarter:dev": "pnpm --filter @moonwitness/headquarter dev",
    "headquarter:build": "pnpm --filter @moonwitness/headquarter build",
    "id:dev": "pnpm --filter @moonwitness/id dev",
    "id:build": "pnpm --filter @moonwitness/id build",
    "web:dev": "pnpm dock:dev",
    "web:build": "pnpm dock:build",
    "extension:build": "pnpm --filter @allah/vscode-extension build",
    "docs:check": "tsx scripts/check-doc-contracts.ts",
    "arsy:dev": "pnpm --filter @allah/arsy dev",
    "arsy:build": "pnpm --filter @allah/arsy build"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "wait-on": "^9.5.1"
  }
}