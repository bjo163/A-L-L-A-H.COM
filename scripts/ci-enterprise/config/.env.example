# CI Enterprise Configuration
# Copy to .env and fill in values

# GitHub (required)
GITHUB_OWNER=bjo163
GITHUB_REPO=A-L-L-A-H.COM
GITHUB_BRANCH=dev
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# LLM Provider (choose one)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1

# Or use Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-opus-20240229
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Or use local LLM (Ollama)
# LLM_PROVIDER=local
# LLM_MODEL=codellama:13b
# LLM_BASE_URL=http://localhost:11434/v1

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx
DISCORD_ROLE_ID=123456789012345678

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASS=your-app-password
ALERT_EMAIL_TO=dev1@domain.com,dev2@domain.com

# Dashboard
DASHBOARD_PORT=3005
DASHBOARD_ALLOWED_USERS=user1,user2
GITHUB_OAUTH_CLIENT_ID=xxx
GITHUB_OAUTH_CLIENT_SECRET=xxx

# Optional: Confidence thresholds
FIX_MIN_CONFIDENCE=0.3
FIX_COMMIT_CONFIDENCE=0.75
