{
  "name": "@allah/arsy",
  "version": "0.1.0",
  "description": "Arsy Fastify Gateway Runtime Server",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format cjs --clean",
    "start": "node dist/main.cjs",
    "test": "tsx --test --test-force-exit test/*.test.mjs"
  },
  "dependencies": {
    "@allah/arsy-core": "workspace:*",
    "@allah/arsy-orm": "workspace:*",
    "@allah/arsy-plugin-auth": "workspace:*",
    "@allah/arsy-plugin-llm-gateway": "workspace:*",
    "@allah/arsy-plugin-sdui": "workspace:*",
    "@allah/arsy-plugin-storage": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
