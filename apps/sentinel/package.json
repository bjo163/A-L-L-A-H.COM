{
  "name": "@allah/sentinel",
  "version": "0.1.0",
  "description": "Sentinel Standalone RADIUS Daemon - High-Performance UDP RADIUS Authentication & Accounting Service",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "start": "node dist/index.js",
    "test": "tsx --test test/**/*.test.mjs"
  },
  "dependencies": {
    "@allah/arsy-core": "workspace:*",
    "@allah/arsy-orm": "workspace:*",
    "@allah/sentinel-radius": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  }
}