{
  "name": "@allah/sentinel",
  "version": "0.1.0",
  "description": "Sentinel Standalone RADIUS Daemon - High-Performance UDP RADIUS Authentication & Accounting Service",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --out-dir dist --clean",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test test/**/*.test.mjs"
  },
  "dependencies": {
    "@allah/arsy-core": "workspace:*",
    "@allah/arsy-orm": "workspace:*",
    "@allah/sentinel-radius": "workspace:*",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  }
}