# MoonWitness / A-L-L-A-H.COM Environment Configuration
# Only variables actually read by the code are listed here. The embedded PGlite
# database lives in a data directory (no DATABASE_URL); storage is content-addressed.

NODE_ENV=production

# ARSY Hub server (apps/arsy) — binds loopback unless HOST=0.0.0.0 (as docker-compose sets)
PORT=5150
HOST=127.0.0.1
LOG_LEVEL=info

# Persistence directories (embedded PGlite + key material; no external SQL database)
ARSY_DATA_DIR=./data
PG_DATA_DIR=./data

# Auth secrets. JWT_SECRET signs session tokens; BETTER_AUTH_SECRET must be a
# DISTINCT value of at least 32 characters. Production ARSY startup fails closed
# without BETTER_AUTH_URL, BETTER_AUTH_SECRET, and a non-empty CORS_ORIGINS.
JWT_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
CORS_ORIGINS=
AUTH_TOKEN_TTL=12h

# NAS secret encryption: arsy encrypts and sentinel decrypts with the SAME key.
ARSY_MASTER_KEY=

# Optional generic-CRUD model allowlist (comma-separated model names).
GENERIC_MODEL_ALLOWLIST=

# Storage content-addressing root (defaults to <cwd>/data/storage).
STORAGE_DIR=

# LLM gateway upstreams (optional; catalog entries exist even without keys).
UPSTREAM_OPENAI_URL=
UPSTREAM_OPENAI_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=
# Allow the gateway to call loopback/private AI endpoints (SSRF exception).
ALLOW_LOCAL_AI=false

# Browser-reachable ARSY origin for apps/id Better Auth calls.
NEXT_PUBLIC_AUTH_API_URL=

# Cross-app navigation. Set the origin when the apps share one domain;
# leave unset in development and each app resolves to its own port on the current host.
NEXT_PUBLIC_ECOSYSTEM_ORIGIN=
NEXT_PUBLIC_DOCK_URL=
NEXT_PUBLIC_HEADQUARTER_URL=
NEXT_PUBLIC_ID_URL=
NEXT_PUBLIC_JIZZ_URL=
NEXT_PUBLIC_GATE_URL=

# Jizz WORLD OBSERVATORY upstream — SERVER ONLY. Read exclusively inside the
# route proxy (apps/jizz/src/app/api/jizz/[...path]); never expose as NEXT_PUBLIC_*.
JIZZ_API_URL=http://localhost:4000
JIZZ_API_KEY=

# Sentinel RADIUS daemon (apps/sentinel)
SENTINEL_AUTH_PORT=1812
SENTINEL_ACCT_PORT=1813
SENTINEL_HTTP_PORT=9181

# Turso / LibSQL Cloud Remote Database (VS Code Project Sync)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=
