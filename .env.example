# MoonWitness / A-L-L-A-H.COM Environment Configuration
NODE_ENV=production
LOCO_ENV=production

# Server Ports & Host
PORT=5150
BINDING=0.0.0.0

# Database
DATABASE_URL=sqlite:///app/data/moonwitness.sqlite?mode=rwc

# Web URL
NEXT_PUBLIC_API_URL=http://server:5150

# Cross-app navigation. Set the origin when the four apps share one domain;
# leave unset in development and each app resolves to its own port on the current host.
NEXT_PUBLIC_ECOSYSTEM_ORIGIN=
NEXT_PUBLIC_DOCK_URL=
NEXT_PUBLIC_HEADQUARTER_URL=
NEXT_PUBLIC_ID_URL=
NEXT_PUBLIC_JIZZ_URL=

