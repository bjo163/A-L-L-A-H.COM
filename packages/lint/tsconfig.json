{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // The linter is unannotated tooling JavaScript; full implicit-any JSDoc
    // coverage adds ceremony without safety. Everything else stays strict.
    "noImplicitAny": false
  },
  "include": ["src/**/*", "bin/**/*"]
}
