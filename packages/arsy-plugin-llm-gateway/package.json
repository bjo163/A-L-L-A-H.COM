{
  "name": "@allah/arsy-plugin-llm-gateway",
  "version": "0.1.0",
  "description": "Arsy LLM Gateway Plugin: rate limiting, semantic caching, SSRF safe upstream proxy",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "tsx --test test/**/*.test.mjs"
  },
  "dependencies": {
    "@allah/arsy-core": "workspace:*",
    "@allah/arsy-orm": "workspace:*",
    "@moonwitness/types": "workspace:*",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "undici": "^7.5.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  }
}
