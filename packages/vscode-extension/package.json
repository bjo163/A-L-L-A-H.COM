{
  "name": "allah-vscode-extension",
  "displayName": "A-L-L-A-H.COM (MoonWitness) Developer Tools",
  "description": "VS Code integration for A-L-L-A-H.COM: Spec-Driven Project Management (.plans), LLM Router Gateway, Echolog Storage, and SDUI.",
  "version": "0.2.0",
  "publisher": "a-l-l-a-h",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Developer Tools"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "allah.createPlan",
        "title": "MoonWitness: Create Spec-Driven Plan (.plans)",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.generatePlanWithAI",
        "title": "MoonWitness: Generate Spec-Driven Plan with AI",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.refreshPlans",
        "title": "MoonWitness: Refresh Project Management Plans",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.testConnection",
        "title": "MoonWitness: Test Gateway Connection",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.listModels",
        "title": "MoonWitness: List Registered LLM Models",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.refreshStorage",
        "title": "MoonWitness: Refresh Echolog Storage Artifacts",
        "category": "A-L-L-A-H"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "allah-explorer",
          "title": "MoonWitness",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "allah-explorer": [
        {
          "id": "allah.views.plans",
          "name": "Project Manager (.plans)",
          "icon": "$(checklist)"
        },
        {
          "id": "allah.views.storage",
          "name": "Echolog Storage (SHA-256)",
          "icon": "$(database)"
        },
        {
          "id": "allah.views.models",
          "name": "LLM Router Models",
          "icon": "$(server)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "allah.generatePlanWithAI",
          "when": "view == allah.views.plans",
          "group": "navigation@1"
        },
        {
          "command": "allah.createPlan",
          "when": "view == allah.views.plans",
          "group": "navigation@2"
        },
        {
          "command": "allah.refreshPlans",
          "when": "view == allah.views.plans",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "A-L-L-A-H MoonWitness",
      "properties": {
        "allah.gatewayUrl": {
          "type": "string",
          "default": "http://127.0.0.1:5150",
          "description": "Base URL of the MoonWitness Loco Rust gateway server."
        },
        "allah.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API Key for authenticated endpoints."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup src/extension.ts --format cjs --external vscode --no-shims --clean",
    "watch": "tsup src/extension.ts --format cjs --external vscode --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.90.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
