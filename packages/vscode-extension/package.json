{
  "name": "allah-vscode-extension",
  "displayName": "A-L-L-A-H.COM (MoonWitness) Developer Tools",
  "description": "Standalone VS Code tools for workspace navigation, .plans project management, diagnostics, Git workflows, templates, and optional local AI providers.",
  "version": "0.3.0",
  "publisher": "a-l-l-a-h",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bjo163/A-L-L-A-H.COM.git",
    "directory": "packages/vscode-extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Developer Tools"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:allah.testConnection",
    "onView:allah.localAgentWorkbench",
    "onView:allah.views.onboarding",
    "onView:allah.views.health",
    "onView:allah.views.providerConfig",
    "onView:allah.views.impactAnalyzer",
    "onView:allah.views.usageDashboard",
    "onView:allah.views.timelineReplay"
  ],
  "contributes": {
    "commands": [
      {
        "command": "allah.createPlan",
        "title": "MoonWitness: Create Spec-Driven Plan (.plans)",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.generatePlanWithAI",
        "title": "MoonWitness: Generate Spec-Driven Plan with AI",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.refreshPlans",
        "title": "MoonWitness: Refresh Project Management Plans",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.markTaskInProgress",
        "title": "MoonWitness: Mark Task In Progress",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.markTaskCompleted",
        "title": "MoonWitness: Mark Task Completed",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.resetTaskToPending",
        "title": "MoonWitness: Reset Task to Pending",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.searchWorkspace",
        "title": "Workspace: Search and Open File",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.showGitStatus",
        "title": "Git: Show Status",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.runApprovedTask",
        "title": "Tasks: Run Approved Validation",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.indexWorkspace",
        "title": "Workspace: Build Context Index",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.focusLocalAgent",
        "title": "Workspace Agent: Focus",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.manageWorkspaceMemory",
        "title": "Workspace Agent: Manage Saved Notes",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.testConnection",
        "title": "MoonWitness: Test Gateway Connection",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.setApiKey",
        "title": "MoonWitness: Set API Key",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.listModels",
        "title": "MoonWitness: List Registered LLM Models",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.showOnboardingWizard",
        "title": "Setup: Start Onboarding Wizard",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.showHealthDashboard",
        "title": "Monitoring: View Health Dashboard",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.configureProviders",
        "title": "LLM: Configure Providers",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.showMissionTimeline",
        "title": "Timeline: Show Recent Events",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.showMissionTemplates",
        "title": "Templates: Browse Mission Templates",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.exportMissionTimeline",
        "title": "Timeline: Export Event Log",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.checkTokenUsage",
        "title": "Tokens: Check Usage & Cost",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.resetHealthMonitor",
        "title": "Monitoring: Reset Health Metrics",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.analyzeImpact",
        "title": "Analysis: Analyze Symbol Impact",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.showUsageDashboard",
        "title": "Budget: View Usage Dashboard",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.showTimelineReplay",
        "title": "Audit: Timeline Replay & Export",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.setBudgetLimit",
        "title": "Budget: Set Monthly Limit",
        "category": "A-L-L-A-H"
      },
      {
        "command": "allah.exportAuditTrail",
        "title": "Audit: Export Full Trail",
        "category": "A-L-L-A-H"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "allah-explorer",
          "title": "MoonWitness",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "allah-explorer": [
        {
          "id": "allah.views.plans",
          "name": "Project Manager (.plans)",
          "icon": "$(checklist)"
        },
        {
          "id": "allah.localAgentWorkbench",
          "name": "Workspace Agent",
          "icon": "$(hubot)"
        },
        {
          "id": "allah.views.onboarding",
          "name": "Setup Wizard",
          "icon": "$(rocket)"
        },
        {
          "id": "allah.views.health",
          "name": "Health Dashboard",
          "icon": "$(pulse)"
        },
        {
          "id": "allah.views.providerConfig",
          "name": "Provider Configuration",
          "icon": "$(settings)"
        },
        {
          "id": "allah.views.impactAnalyzer",
          "name": "Impact Analyzer",
          "icon": "$(git-branch)"
        },
        {
          "id": "allah.views.usageDashboard",
          "name": "Usage & Budget",
          "icon": "$(graph)"
        },
        {
          "id": "allah.views.timelineReplay",
          "name": "Audit Trail & Replay",
          "icon": "$(history)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "allah.views.plans",
        "contents": "Open a workspace folder to browse its plans.",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "allah.views.plans",
        "contents": "No plans found. [Create a plan](command:allah.createPlan) or [generate one from the gateway](command:allah.generatePlanWithAI).",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "allah.generatePlanWithAI",
          "when": "view == allah.views.plans",
          "group": "navigation@1"
        },
        {
          "command": "allah.createPlan",
          "when": "view == allah.views.plans",
          "group": "navigation@2"
        },
        {
          "command": "allah.refreshPlans",
          "when": "view == allah.views.plans",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "allah.markTaskInProgress",
          "when": "view == allah.views.plans && viewItem == taskItem",
          "group": "task@1"
        },
        {
          "command": "allah.markTaskCompleted",
          "when": "view == allah.views.plans && viewItem == taskItem",
          "group": "task@2"
        },
        {
          "command": "allah.resetTaskToPending",
          "when": "view == allah.views.plans && viewItem == taskItem",
          "group": "task@3"
        }
      ]
    },
    "configuration": {
      "title": "A-L-L-A-H MoonWitness",
      "properties": {
        "allah.gatewayUrl": {
          "type": "string",
          "default": "http://127.0.0.1:5150",
          "description": "Base URL of the MoonWitness LLM gateway."
        },
        "allah.arsyUrl": {
          "type": "string",
          "default": "http://127.0.0.1:5150",
          "description": "Base URL of the Arsy API server."
        },
        "allah.plannerModel": {
          "type": "string",
          "default": "dx-reasoning",
          "description": "LLM model used to generate project plans."
        },
        "allah.agentModel": {
          "type": "string",
          "default": "",
          "description": "Optional model identifier used by workspace agent sessions."
        },
        "allah.agentProvider": {
          "type": "string",
          "enum": [
            "gateway",
            "ollama"
          ],
          "default": "gateway",
          "description": "Backend for Workspace Agent responses. Ollama runs locally at the configured URL."
        },
        "allah.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama HTTP endpoint used when agentProvider is ollama."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "watch": "tsup --config tsup.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "test:integration": "pnpm build && node ./test/runTest.js",
    "package": "vsce package --no-dependencies",
    "check-runtime": "node ../../scripts/check-vscode-extension-runtime.mjs",
    "check-standalone": "node ../../scripts/check-vscode-extension-standalone.mjs",
    "check-manifest": "node ../../scripts/check-vscode-extension-manifest.mjs",
    "check-package": "node ../../scripts/check-vscode-extension-package.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "mocha": "^12.0.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
