{
  "name": "@allah/arsy-plugin-auth",
  "version": "0.1.0",
  "description": "Arsy Authentication Plugin: JWT, password hashing, and user lifecycle",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "@allah/arsy-core": "workspace:*",
    "@allah/arsy-orm": "workspace:*",
    "@fastify/jwt": "^9.0.4",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  }
}
